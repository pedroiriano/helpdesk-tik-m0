<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HelpdeskDepok" targetNamespace="urn:helpdesk-depok:bpmn:2026-11-11" exporter="Helpdesk TIK Kota Depok">
  <bpmn:message id="Msg_Laporan" name="Laporan awal"/>
  <bpmn:message id="Msg_Reopen" name="Permintaan buka kembali"/>
  <bpmn:message id="Msg_Info" name="Permintaan informasi"/>
  <bpmn:message id="Msg_Pelengkap" name="Informasi pelengkap"/>
  <bpmn:message id="Msg_Batal" name="Pembatalan oleh pemohon"/>
  <bpmn:message id="Msg_Hasil" name="Pemberitahuan hasil"/>
  <bpmn:message id="Msg_Tanggapan" name="Tanggapan atas upaya resolusi"/>
  <bpmn:process id="Process_Helpdesk" name="Penanganan tiket Helpdesk TIK" isExecutable="false">
    <bpmn:documentation>Scope layanan tiket sintetis. Penugasan dan penutupan memakai versi tiket dan scope yang diperiksa saat commit. Pemeriksaan SLA, vendor dan handoff diuraikan pada panduan pendamping.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Helpdesk">
      <bpmn:lane id="Lane_Sistem" name="Portal dan Sistem Helpdesk">
        <bpmn:flowNodeRef>Terima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rekam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GagalValidasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MintaReopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CekReopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BolehReopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EpisodeBaru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GagalReopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MasukTriase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TungguInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InfoDatang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BatalDatang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lengkapi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BatalKlarifikasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AkhirBatalInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notifikasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TungguHasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Respons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tenggat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TerimaHasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AkhirSetuju</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TolakHasil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SyaratAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AkhirAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tahan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GabungTunggu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TungguLanjut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResponsLanjut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pulih</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Usang</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Operator">
        <bpmn:flowNodeRef>Tinjau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Keputusan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verifikasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Klarifikasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AkhirBatal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Koordinator" name="Koordinator / petugas berizin">
        <bpmn:flowNodeRef>MasukDisposisi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kandidat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tugaskan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TinjauRouting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teknisi" name="Teknisi L1 / L2">
        <bpmn:flowNodeRef>Mulai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GabungKerja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kerjakan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolusi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Terima" name="Laporan masuk">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Laporan"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validasi" name="Validasi layanan, akses, dan formulir">
      <bpmn:documentation>M1/M2 memeriksa audience dan scope. M3 memeriksa versi layanan/form/policy dan intent. Tamu memakai capability; lampiran mengikuti izin dan scan.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Valid?" default="F03" gatewayDirection="Diverging">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rekam" name="Rekam tiket OPEN dan usulan M4">
      <bpmn:documentation>M3 menyimpan OPEN/PENDING, snapshot, riwayat, receipt dan outbox. Usulan klasifikasi deterministik M4 terpisah dari keputusan operator.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="GagalValidasi" name="Pengajuan perlu diperbaiki">
      <bpmn:incoming>F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="MintaReopen" name="Permintaan buka kembali">
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Reopen"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CekReopen" name="Periksa izin, alasan dan batas reopen">
      <bpmn:documentation>Tiket CLOSED, bukan arsip, scope sah, attempt penutupan yang valid, versi cocok dan sebelum tenggat. Fixture lab tujuh hari sejak penutupan.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BolehReopen" name="Memenuhi syarat?" default="F08" gatewayDirection="Diverging">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="EpisodeBaru" name="Buka episode baru yang terhubung">
      <bpmn:documentation>M3 membuat relasi episode, mengembalikan OPEN/PENDING dan mempertahankan waktu penerimaan awal serta histori sebelumnya.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="GagalReopen" name="Tetap CLOSED">
      <bpmn:incoming>F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="MasukTriase" gatewayDirection="Converging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Tinjau" name="Tinjau laporan dan saran M4">
      <bpmn:documentation>Operator meninjau kelengkapan, cakupan, duplikasi dan dampak.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Keputusan" name="Hasil telaah?" default="F14" gatewayDirection="Diverging">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Verifikasi" name="Sahkan kategori dan prioritas">
      <bpmn:documentation>Status TRIAGED dan verification VERIFIED. Perbedaan dari saran disertai alasan dan bukti audit.</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Klarifikasi" name="Minta informasi tambahan" messageRef="Msg_Info">
      <bpmn:documentation>M3 menandai NEEDS_INFORMATION. Permintaan informasi juga tersedia saat TRIAGED sesuai kewenangan.</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Tolak" name="Tolak / batalkan dengan alasan">
      <bpmn:documentation>Untuk laporan yang ditolak atau pembatalan berizin sebelum dispatch. Riwayat dipertahankan.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="AkhirBatal" name="CANCELLED">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="TungguInfo" name="Tunggu pemohon" gatewayDirection="Diverging" eventGatewayType="Exclusive" instantiate="false">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="InfoDatang" name="Informasi diterima">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Pelengkap"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="BatalDatang" name="Pembatalan diterima">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Batal"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Lengkapi" name="Simpan pelengkapan OPEN · PENDING">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BatalKlarifikasi" name="Validasi dan catat pembatalan">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AkhirBatalInfo" name="CANCELLED">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="MasukDisposisi" gatewayDirection="Converging">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Saran" name="Susun usulan Smart Dispatch">
      <bpmn:documentation>M5 menerapkan routing aktif, tier, tim, skill, identitas, waktu roster, mandat OPD dan beban proyeksi. Urutan deterministik.</bpmn:documentation>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Kandidat" name="Ada kandidat?" default="F27" gatewayDirection="Diverging">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Tugaskan" name="Pilih dan tetapkan teknisi L1/L2">
      <bpmn:documentation>Petugas berizin memilih kandidat sah, mencatat alasan dan mengirim versi serta digest. Commit M3 mengubah tiket menjadi ASSIGNED.</bpmn:documentation>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TinjauRouting" name="Tinjau tier, routing dan roster">
      <bpmn:documentation>Tetap menunggu disposisi. Perbaikan master hanya oleh admin berizin. Kandidat tidak dipilih di luar kelayakan.</bpmn:documentation>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Mulai" name="Mulai penanganan IN_PROGRESS">
      <bpmn:documentation>Assignee aktif memulai tindakan pada versi yang sah.</bpmn:documentation>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GabungKerja" gatewayDirection="Converging">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Kerjakan" name="Diagnosis, tindak dan catat pekerjaan">
      <bpmn:documentation>Cabang vendor/handoff dan perhitungan SLA dirujuk ke panduan. Teknisi internal tetap bertanggung jawab dan memeriksa hasil.</bpmn:documentation>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Resolusi" name="Nyatakan selesai RESOLVED">
      <bpmn:documentation>Upaya resolusi baru. Tenggat konfirmasi dihitung sejak resolved_at.</bpmn:documentation>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Notifikasi" name="Beritahu hasil dan tenggat" messageRef="Msg_Hasil">
      <bpmn:documentation>Publikasikan pemberitahuan dalam aplikasi melalui outbox. Bukti durable diperiksa sebelum auto-close.</bpmn:documentation>
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="TungguHasil" name="Tunggu respons" gatewayDirection="Diverging" eventGatewayType="Exclusive" instantiate="false">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Respons" name="Tanggapan masuk">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Tanggapan"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Tenggat" name="24 jam kalender">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">confirmation_due_at</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Hasil" name="Isi tanggapan?" default="F41" gatewayDirection="Converging">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:incoming>F53</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TerimaHasil" name="Tutup dengan konfirmasi pemohon">
      <bpmn:documentation>M3 memeriksa requester, attempt dan versi. Closure reason REQUESTER_CONFIRMED.</bpmn:documentation>
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AkhirSetuju" name="CLOSED · disetujui">
      <bpmn:incoming>F40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TolakHasil" name="Catat penolakan sah pada episode yang sama">
      <bpmn:documentation>Dalam kandidat lab kembali IN_PROGRESS. Blueprint mengatur peninjauan TRIAGED jika assignee sudah tidak sah.</bpmn:documentation>
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Feedback" name="Catat feedback REVIEW_REQUIRED">
      <bpmn:documentation>Feedback non-keputusan menahan penutupan otomatis. Kasus tetap RESOLVED sampai ada tanggapan sah.</bpmn:documentation>
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F49</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SyaratAuto" name="Guard terpenuhi?" default="F45" gatewayDirection="Converging">
      <bpmn:documentation>Tenggat tercapai, masih RESOLVED, upaya aktif dan versi cocok, tidak ada feedback, bukti notifikasi dalam aplikasi sudah durable.</bpmn:documentation>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:incoming>F54</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
      <bpmn:outgoing>F46</bpmn:outgoing>
      <bpmn:outgoing>F55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Auto" name="Tutup otomatis AUTO_NO_RESPONSE">
      <bpmn:documentation>M3 melakukan commit bersyarat dengan CAS. Saat konflik, baca state/upaya terbaru sebelum tindakan berikutnya.</bpmn:documentation>
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AkhirAuto" name="CLOSED · tanpa tanggapan">
      <bpmn:incoming>F47</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Tahan" name="Tahan auto-close dan rekonsiliasi">
      <bpmn:documentation>Ketika upaya masih RESOLVED dan syarat belum lengkap. Upaya usang atau sudah berubah diabaikan, tanpa mutasi tiket.</bpmn:documentation>
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GabungTunggu" gatewayDirection="Converging">
      <bpmn:incoming>F48</bpmn:incoming>
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="TungguLanjut" name="Tunggu tindak lanjut" gatewayDirection="Diverging" eventGatewayType="Exclusive" instantiate="false">
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F51</bpmn:outgoing>
      <bpmn:outgoing>F52</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ResponsLanjut" name="Tanggapan lanjutan">
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F53</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Tanggapan"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Pulih" name="Bukti tersedia">
      <bpmn:incoming>F52</bpmn:incoming>
      <bpmn:outgoing>F54</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Bukti durable tersedia setelah tenggat, upaya masih aktif, versi cocok dan tidak ada feedback.</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Usang" name="Upaya berubah">
      <bpmn:incoming>F55</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Terima" targetRef="Validasi"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Validasi" targetRef="Valid"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Valid" targetRef="GagalValidasi" name="Tidak"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Valid" targetRef="Rekam" name="Ya">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Layanan, audience, formulir dan intent sah</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="Rekam" targetRef="MasukTriase"/>
    <bpmn:sequenceFlow id="F06" sourceRef="MintaReopen" targetRef="CekReopen"/>
    <bpmn:sequenceFlow id="F07" sourceRef="CekReopen" targetRef="BolehReopen"/>
    <bpmn:sequenceFlow id="F08" sourceRef="BolehReopen" targetRef="GagalReopen" name="Tidak"/>
    <bpmn:sequenceFlow id="F09" sourceRef="BolehReopen" targetRef="EpisodeBaru" name="Ya">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Izin dan policy reopen terpenuhi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="EpisodeBaru" targetRef="MasukTriase"/>
    <bpmn:sequenceFlow id="F11" sourceRef="MasukTriase" targetRef="Tinjau"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Tinjau" targetRef="Keputusan"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Keputusan" targetRef="Verifikasi" name="Verifikasi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Laporan lengkap dan dalam lingkup</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="Keputusan" targetRef="Tolak" name="Tolak / batal"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Tolak" targetRef="AkhirBatal"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Keputusan" targetRef="Klarifikasi" name="Perlu informasi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Informasi perlu dilengkapi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="Klarifikasi" targetRef="TungguInfo"/>
    <bpmn:sequenceFlow id="F18" sourceRef="TungguInfo" targetRef="InfoDatang"/>
    <bpmn:sequenceFlow id="F19" sourceRef="TungguInfo" targetRef="BatalDatang"/>
    <bpmn:sequenceFlow id="F20" sourceRef="InfoDatang" targetRef="Lengkapi"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Lengkapi" targetRef="MasukTriase" name="Verifikasi ulang"/>
    <bpmn:sequenceFlow id="F22" sourceRef="BatalDatang" targetRef="BatalKlarifikasi"/>
    <bpmn:sequenceFlow id="F23" sourceRef="BatalKlarifikasi" targetRef="AkhirBatalInfo"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Verifikasi" targetRef="MasukDisposisi"/>
    <bpmn:sequenceFlow id="F25" sourceRef="MasukDisposisi" targetRef="Saran"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Saran" targetRef="Kandidat"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Kandidat" targetRef="TinjauRouting" name="Tidak"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Kandidat" targetRef="Tugaskan" name="Ya">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tersedia kandidat yang memenuhi aturan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F29" sourceRef="TinjauRouting" targetRef="MasukDisposisi"/>
    <bpmn:sequenceFlow id="F30" sourceRef="Tugaskan" targetRef="Mulai"/>
    <bpmn:sequenceFlow id="F31" sourceRef="Mulai" targetRef="GabungKerja"/>
    <bpmn:sequenceFlow id="F32" sourceRef="GabungKerja" targetRef="Kerjakan"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Kerjakan" targetRef="Resolusi"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Resolusi" targetRef="Notifikasi"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Notifikasi" targetRef="TungguHasil"/>
    <bpmn:sequenceFlow id="F36" sourceRef="TungguHasil" targetRef="Respons"/>
    <bpmn:sequenceFlow id="F37" sourceRef="TungguHasil" targetRef="Tenggat"/>
    <bpmn:sequenceFlow id="F38" sourceRef="Respons" targetRef="Hasil"/>
    <bpmn:sequenceFlow id="F39" sourceRef="Hasil" targetRef="TerimaHasil" name="Setuju">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Konfirmasi penerimaan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F40" sourceRef="TerimaHasil" targetRef="AkhirSetuju"/>
    <bpmn:sequenceFlow id="F41" sourceRef="Hasil" targetRef="Feedback" name="Feedback"/>
    <bpmn:sequenceFlow id="F42" sourceRef="Hasil" targetRef="TolakHasil" name="Belum selesai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Penolakan yang sah</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F43" sourceRef="TolakHasil" targetRef="GabungKerja" name="Lanjutkan penanganan"/>
    <bpmn:sequenceFlow id="F44" sourceRef="Tenggat" targetRef="SyaratAuto"/>
    <bpmn:sequenceFlow id="F45" sourceRef="SyaratAuto" targetRef="Tahan" name="Belum lengkap"/>
    <bpmn:sequenceFlow id="F46" sourceRef="SyaratAuto" targetRef="Auto" name="Ya">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tenggat dan seluruh guard terpenuhi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F47" sourceRef="Auto" targetRef="AkhirAuto"/>
    <bpmn:sequenceFlow id="F48" sourceRef="Tahan" targetRef="GabungTunggu"/>
    <bpmn:sequenceFlow id="F49" sourceRef="Feedback" targetRef="GabungTunggu"/>
    <bpmn:sequenceFlow id="F50" sourceRef="GabungTunggu" targetRef="TungguLanjut"/>
    <bpmn:sequenceFlow id="F51" sourceRef="TungguLanjut" targetRef="ResponsLanjut"/>
    <bpmn:sequenceFlow id="F52" sourceRef="TungguLanjut" targetRef="Pulih"/>
    <bpmn:sequenceFlow id="F53" sourceRef="ResponsLanjut" targetRef="Hasil" name="Tinjau tanggapan lanjutan"/>
    <bpmn:sequenceFlow id="F54" sourceRef="Pulih" targetRef="SyaratAuto" name="Periksa ulang guard"/>
    <bpmn:sequenceFlow id="F55" sourceRef="SyaratAuto" targetRef="Usang" name="Sudah berubah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Status, versi atau upaya tidak lagi aktif</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Helpdesk" name="Helpdesk TIK Kota Depok">
    <bpmn:participant id="Pool_Pemohon" name="Pemohon · Tamu, publik, ASN atau petugas sesuai kebijakan"/>
