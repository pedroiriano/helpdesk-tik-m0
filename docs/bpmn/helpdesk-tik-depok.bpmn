    <bpmn:messageFlow id="M06" name="Hasil dan tenggat" messageRef="Msg_Hasil" sourceRef="Notifikasi" targetRef="Pool_Pemohon"/>
    <bpmn:messageFlow id="M07" name="Tanggapan" messageRef="Msg_Tanggapan" sourceRef="Pool_Pemohon" targetRef="Respons"/>
    <bpmn:messageFlow id="M08" name="Tanggapan lanjutan" messageRef="Msg_Tanggapan" sourceRef="Pool_Pemohon" targetRef="ResponsLanjut"/>
  </bpmn:collaboration>
