{
  "openapi": "3.1.0",
  "info": {
    "title": "Helpdesk TIK Kota Depok — health",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Periksa proses HTTP",
        "responses": {
          "200": {
            "description": "Proses hidup",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "live"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Periksa pool dan versi schema setiap modul",
        "responses": {
          "200": {
            "description": "Semua owner siap",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Dependency belum siap",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "unavailable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
