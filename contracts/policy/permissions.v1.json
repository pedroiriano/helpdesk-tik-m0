      "scope": "self",
      "permissions": [
        "ticket.create",
        "ticket.read",
        "ticket.comment",
        "ticket.attach",
        "ticket.confirm",
        "ticket.transition",
        "draft.read",
        "draft.write",
        "media.read",
        "media.write",
        "operation.read"
      ]
    },
    "PUBLIC": {
      "scope": "self",
      "permissions": [
        "session.read",
        "session.revoke",
        "ticket.create",
        "ticket.read",
        "ticket.comment",
        "ticket.attach",
        "ticket.confirm",
        "ticket.transition",
        "draft.read",
        "draft.write",
        "media.read",
        "media.write",
        "media.reuse",
        "notification.read",
        "notification.binding",
        "operation.read"
      ]
    },
    "ASN": {
      "scope": "self",
      "permissions": [
        "session.read",
        "session.revoke",
        "ticket.create",
        "ticket.read",
        "ticket.comment",
        "ticket.attach",
        "ticket.confirm",
        "ticket.transition",
        "draft.read",
        "draft.write",
        "media.read",
        "media.write",
        "notification.read",
        "operation.read",
        "notification.binding"
      ]
    },
    "OPERATOR": {
      "scope": "org",
      "permissions": [
        "ticket.read",
        "ticket.verify",
        "ticket.dispatch",
        "ticket.comment",
        "ticket.attach",
        "ticket.transition",
        "operation.read",
        "media.read",
        "ticket.bulk"
      ]
    },
    "TECHNICIAN": {
      "scope": "assigned",
      "permissions": [
        "ticket.read",
        "ticket.resolve",
        "ticket.comment",
        "ticket.attach",
        "ticket.transition",
        "ticket.vendor",
        "ticket.escalate",
        "operation.read",
        "media.read",
        "ticket.worklog"
      ]
    },
    "COORDINATOR": {
      "scope": "org",
      "permissions": [
        "ticket.read",
        "ticket.dispatch",
        "ticket.transition",
        "ticket.comment",
        "ticket.pause",
        "ticket.handoff",
        "ticket.handoff.accept",
        "ticket.escalate",
        "report.read",
        "report.export",
        "operation.read",
        "ticket.bulk",
        "ticket.archive",
        "media.write",
        "media.reuse",
        "notification.read",
        "notification.binding"
      ]
    },
    "LEADERSHIP": {
      "scope": "org",
      "permissions": [
        "ticket.read",
        "ticket.escalate",
        "report.read",
        "report.export"
      ]
    },
    "ADMIN_OPD": {
      "scope": "org",
      "permissions": [
        "identity.grant",
        "catalog.write",
        "rules.write",
        "system.health",
        "notification.read",
        "notification.binding"
      ]
    },
    "PLATFORM_ADMIN": {
      "scope": "org",
      "permissions": [
        "identity.grant",
        "catalog.write",
        "rules.write",
        "system.maintenance",
        "system.job",
        "system.health",
        "identity.organization.create",
        "notification.read",
        "notification.binding"
      ]
    },
    "SUPER_ADMIN": {
      "scope": "org",
      "permissions": [
        "identity.grant",
        "catalog.write",
        "rules.write",
        "system.maintenance",
        "system.job",
        "system.health",
        "system.purge.request",
        "identity.organization.create",
        "notification.read",
        "notification.binding",
        "identity.role.manage",
        "media.read",
        "media.write",
        "media.reuse",
        "content.read",
        "content.write",
        "content.publish",
        "hero.write",
        "hero.publish"
      ]
    },
    "EDITOR": {
      "scope": "org",
      "permissions": [
        "content.read",
        "content.write",
        "media.read",
        "media.write",
        "media.reuse",
        "draft.read",
        "draft.write",
        "hero.write"
      ]
    },
    "PUBLISHER": {
      "scope": "org",
      "permissions": [
        "content.read",
        "content.write",
        "content.publish",
        "media.read",
        "media.reuse",
        "hero.publish"
      ]
    },
    "AUDITOR": {
      "scope": "org",
      "permissions": [
        "audit.read",
        "report.read",
        "report.export"
      ]
    },
    "AUTO_CLOSE_SERVICE": {
      "scope": "bound_ticket",
      "permissions": [
        "ticket.auto_close"
      ]
    },
    "VENDOR": {
      "scope": "disabled",
      "permissions": []
    }
  },
  "public_permissions": [
    "catalog.read",
    "content.read"
  ],
  "read_surfaces": [
    "detail",
    "list",
    "count",
    "search",
    "export",
    "download",
    "projection",
    "job_result"
  ],
  "constraints": {
    "trusted_actor_required": true,
    "live_revocation_required": true,
    "config_admin_implicit_ticket_read": false,
    "capability_is_ticket_number": false,
    "filter_before_aggregate_and_pagination": true,
    "purge_enabled": false,
    "vendor_portal_enabled": false
  }
}
